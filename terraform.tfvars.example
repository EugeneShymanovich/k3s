# Copy to terraform.tfvars (gitignored) and fill in the token.
# Never commit the real token.
#
#   cp terraform.tfvars.example terraform.tfvars
#
hcloud_token = "CHANGE_ME"

# Optional overrides
# location             = "hel1"
# server_type          = "cx23"
# image                = "ubuntu-26.04"
# ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
# ssh_cidr             = "203.0.113.10/32"
